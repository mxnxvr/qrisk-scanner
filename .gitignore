name: CI

on:
  push:
  pull_request:

jobs:
  test:
    runs-on: ${{ matrix.os }}
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, windows-latest]
        python: ["3.10", "3.11", "3.12", "3.13"]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python }}
      - run: pip install -e ".[dev]"
      - run: pytest -v -m "not network"
      - name: Smoke-test the CLI
        run: qrisk scan --path tests --code src --config tests --json results.json --cbom cbom.json --html report.html --fail-under 80 --allow-empty

  lab:
    # Starts the Docker lab and checks every server gets the rating it was built for.
    runs-on: ubuntu-latest
    env:
      QRISK_LAB_REQUIRED: "1"
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.13"
      - run: pip install -e ".[dev]"
      - run: docker compose -f lab/docker-compose.yml up -d --build
      - name: Wait for lab ports
        run: |
          python - <<'EOF'
          import socket, time
          ports, deadline = [8443, 8444, 8445, 2222, 2223], time.time() + 90
          while ports and time.time() < deadline:
              for p in list(ports):
                  try:
                      socket.create_connection(("127.0.0.1", p), timeout=1).close()
                      ports.remove(p)
                  except OSError:
                      pass
              time.sleep(1)
          raise SystemExit(f"ports not up: {ports}" if ports else 0)
          EOF
      - run: pytest -v -m lab
      - name: Full lab scan report
        run: >
          qrisk scan --tls localhost:8443 --tls localhost:8444 --tls localhost:8445
          --ssh localhost:2222 --ssh localhost:2223 --path lab/nginx/certs
          --code lab/sample-app --config lab --html lab-report.html --cbom lab-cbom.json
      - uses: actions/upload-artifact@v4
        with:
          name: lab-report
          path: |
            lab-report.html
            lab-cbom.json
      - if: failure()
        run: docker compose -f lab/docker-compose.yml logs
